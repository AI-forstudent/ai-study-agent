# --- Stage 1: Base ---
# Installs dependencies once; shared by all downstream stages.
FROM node:20-alpine AS base
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .

# --- Stage 2: Development (For "The Monster") ---
# Runs the Vite dev server with HMR. Targeted by docker-compose.override.yml.
# Source code is bind-mounted at runtime, so no rebuild is needed on file changes.
FROM base AS development
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

# --- Stage 3: Builder ---
# Compiles the React app into static assets under /app/dist.
# VITE_AI_API_URL is baked into the JS bundle at build time.
FROM base AS builder
ARG VITE_AI_API_URL
ENV VITE_AI_API_URL=$VITE_AI_API_URL
RUN npm run build

# --- Stage 4: Production (Nginx) ---
# Serves the compiled static assets via Nginx. Targeted by docker-compose.prod.yml.
FROM nginx:alpine AS production

# Register .mjs as a JavaScript MIME type so ES modules load correctly in browsers.
RUN sed -i '/application\/javascript/ s/js;/js mjs;/' /etc/nginx/mime.types
RUN echo "types { application/javascript mjs; }" > /etc/nginx/conf.d/mjs.conf

# Copy compiled assets from the builder stage.
COPY --from=builder /app/dist /usr/share/nginx/html

# Install our reverse-proxy config as a template; the official nginx image runs
# envsubst on /etc/nginx/templates/*.template at container start and writes the
# rendered output to /etc/nginx/conf.d/. ${DOMAIN} is supplied via env var.
COPY nginx.conf.template /etc/nginx/templates/default.conf.template

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
