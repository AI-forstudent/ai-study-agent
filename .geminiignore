# ─────────────────────────────────────────────
# Secrets — CRITICAL, never expose to AI tools
# ─────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
ai-study-key.pem
secrets/
**/credentials.json

# ─────────────────────────────────────────────
# Dependencies & build artifacts (token bloat)
# ─────────────────────────────────────────────
node_modules/
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.uv/
dist/
build/
.next/
.cache/
coverage/
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─────────────────────────────────────────────
# Lock files — huge, AI doesn't need them
# ─────────────────────────────────────────────
package-lock.json
yarn.lock
pnpm-lock.yaml
uv.lock
poetry.lock

# ─────────────────────────────────────────────
# Uploads & generated content
# ─────────────────────────────────────────────
uploads/
backend/uploads/
*.log
logs/

# ─────────────────────────────────────────────
# Local/system files
# ─────────────────────────────────────────────
.DS_Store
desktop.ini
Thumbs.db
.vscode/
.idea/

# ─────────────────────────────────────────────
# Docker & local DB volumes
# ─────────────────────────────────────────────
postgres-data/
docker-compose.override.yml

# ─────────────────────────────────────────────
# Test artifacts
# ─────────────────────────────────────────────
playwright-report/
test-results/
.playwright/
