# 1. נקודת ההתחלה: לינוקס עם פייתון 3.11
FROM python:3.11-slim

# 2. הגדרת תיקיית העבודה בתוך הקונטיינר
WORKDIR /app

# 3. התקנת LibreOffice (המרת DOCX/PPTX ל-PDF) ו-uv
RUN apt-get update && apt-get install -y --no-install-recommends \
        libreoffice \
        fonts-liberation \
        fonts-dejavu-core \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN pip install uv

# 4. העתקת קבצי החבילות בלבד
COPY pyproject.toml uv.lock ./

# 5. התקנת הספריות (בצורה נעילה כדי למנוע הפתעות של גרסאות)
RUN uv sync --frozen

# 6. העתקת שאר קבצי הפרויקט לתוך הקונטיינר
COPY . .

# 7. הפקודה שתרוץ כשהקונטיינר נדלק
CMD ["uv", "run", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]