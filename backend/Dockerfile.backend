# Base image: Python 3.13-slim matches the version pinned in pyproject.toml.
FROM python:3.13-slim

WORKDIR /app

# Install LibreOffice (DOCX/PPTX → PDF) + Pandoc + XeLaTeX for the F-036
# unified-summary PDF pipeline. Pandoc converts the AI-generated markdown
# to a LaTeX document and xelatex renders it — needed because the AI
# emits LaTeX math (`$\nabla\cdot\vec{E}$`, etc.) that an HTML renderer
# can't typeset. The TeX Live subset (-xetex, -latex-extra, -lang-other,
# -fonts-recommended) gives us polyglossia for Hebrew RTL, AMS math, and
# tcolorbox without pulling the full ~5GB texlive-full.
#
# fonts-culmus carries the classic Debian Hebrew font set (David, Frank
# Ruehl, Miriam); fonts-dejavu-core is the Latin fallback. Polyglossia
# picks one of these automatically based on the script.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libreoffice \
        fonts-liberation \
        fonts-dejavu-core \
        fonts-culmus \
        pandoc \
        texlive-xetex \
        texlive-latex-extra \
        texlive-fonts-recommended \
        texlive-lang-other \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN pip install uv

# Copy dependency manifests first to maximise layer caching.
COPY pyproject.toml uv.lock ./

# Install all dependencies. Using uv sync (without --frozen) allows the lockfile
# to update when new packages are added to pyproject.toml.
RUN uv sync

# Copy the rest of the project source.
COPY . .

CMD ["uv", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
