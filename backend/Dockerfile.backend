# Base image: Python 3.13-slim matches the version pinned in pyproject.toml.
FROM python:3.13-slim

WORKDIR /app

# Install LibreOffice (for DOCX/PPTX → PDF conversion) and uv (package manager).
# Pango / harfbuzz / cairo also power weasyprint (F-036 — markdown → PDF for
# AI-generated unified summaries). LibreOffice pulls most of these in
# transitively, but listing them explicitly survives package-set drift.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libreoffice \
        fonts-liberation \
        fonts-dejavu-core \
        fonts-noto-hebrew \
        libpango-1.0-0 \
        libpangoft2-1.0-0 \
        libharfbuzz0b \
        libfontconfig1 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN pip install uv

# Copy dependency manifests first to maximise layer caching.
COPY pyproject.toml uv.lock ./

# Install all dependencies. Using uv sync (without --frozen) allows the lockfile
# to update when new packages are added to pyproject.toml.
RUN uv sync

# Copy the rest of the project source.
COPY . .

CMD ["uv", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
