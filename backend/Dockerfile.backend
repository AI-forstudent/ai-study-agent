# 1. נקודת ההתחלה: לינוקס עם פייתון 3.11
FROM python:3.11-slim

# 2. הגדרת תיקיית העבודה בתוך הקונטיינר
WORKDIR /app

# 3. התקנת מנהל החבילות uv
RUN pip install uv

# 4. העתקת קבצי החבילות בלבד
COPY pyproject.toml uv.lock ./

# 5. התקנת הספריות (בצורה נעילה כדי למנוע הפתעות של גרסאות)
RUN uv sync --frozen

# 6. העתקת שאר קבצי הפרויקט לתוך הקונטיינר
COPY . .

# 7. הפקודה שתרוץ כשהקונטיינר נדלק
CMD ["uv", "run", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]