# ============================================================
# Environment Variables Template
# ------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
# In production, these are injected by GitHub Actions from Secrets.
# ============================================================

# The production domain (no protocol, no www).
# Examples: ai-forstudent.com, mysite.io
DOMAIN=

# AI Provider Keys (at least one required)
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# JWT Signing — REQUIRED. Generate with: openssl rand -hex 32
SECRET_KEY=

# Google Sign-In (optional). Leave blank to disable the Google button.
# 1. https://console.cloud.google.com/apis/credentials → "Create Credentials"
#    → "OAuth client ID" → Web application.
# 2. Add authorized JavaScript origins: http://localhost:5173 (dev) and your
#    production domain.
# 3. Copy the Client ID into BOTH variables below — backend verifies the ID
#    token, frontend renders the GIS button.
GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_OAUTH_CLIENT_ID=
